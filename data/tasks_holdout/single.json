 {
  "id": "sh_dnd_on",
  "tier": "single",
  "messages": [
   {
    "role": "user",
    "content": "Turn on Do Not Disturb."
   }
  ],
  "catalog": [
   "system.toggle_dnd"
  ],
  "expect": {
   "kind": "tool_call",
   "calls": [
    {
     "name": "system.toggle_dnd",
     "args": {
      "enabled": true
     },
     "arg_match": {
      "enabled": "exact"
     }
    }
   ]
  }
 },
