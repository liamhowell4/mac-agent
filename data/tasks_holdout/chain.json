[
 {
  "id": "ch_resume_email",
  "tier": "chain",
  "messages": [
   {
    "role": "user",
    "content": "Find my resume and email it to Marcus Lee."
   }
  ],
  "catalog": [
   "files.search",
   "mail.send",
   "contacts.find"
  ],
  "expect": {
   "kind": "chain",
   "calls": [
    {
     "name": "files.search",
     "args": {
      "query": "*"
     },
     "any_of": [
      "files.recent",
      "files.list_dir"
     ]
    },
    {
     "name": "mail.send",
     "args": {
      "to": "Marcus"
     },
     "arg_match": {
      "to": "contact"
     }
    }
   ]
  }
 },
