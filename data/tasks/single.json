[
 {
  "id": "single_vol",
  "tier": "single",
  "messages": [
   {
    "role": "user",
    "content": "Set the volume to 30."
   }
  ],
  "catalog": [
   "system.set_volume"
  ],
  "expect": {
   "kind": "tool_call",
   "calls": [
    {
     "name": "system.set_volume",
     "args": {
      "level": 30
     },
     "arg_match": {
      "level": "exact"
     }
    }
   ]
  },
  "notes": "structured arg, exact match"
 },
