[
  {
    "id": "chain_move2pm",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Move my 2pm to 3:30."}],
    "catalog": ["calendar.list_events", "calendar.update_event"],
    "expect": {"kind": "chain", "calls": [
      {"name": "calendar.list_events", "args": {}, "arg_match": {}},
      {"name": "calendar.update_event", "args": {"event_id": "*", "new_start": "15:30"},
       "arg_match": {"event_id": "present", "new_start": "normalized"}}]},
    "notes": "must resolve '2pm' to event_id via list_events first"
  },
  {
    "id": "chain_cancel_gym",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Cancel my gym workout today."}],
    "catalog": ["calendar.list_events", "calendar.delete_event"],
    "expect": {"kind": "chain", "calls": [
      {"name": "calendar.list_events", "args": {}, "arg_match": {}},
      {"name": "calendar.delete_event", "args": {"event_id": "*"}, "arg_match": {"event_id": "present"}}]}
  },
  {
    "id": "chain_reply_alex",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Reply to Alex's budget email and tell him I'll review it today."}],
    "catalog": ["mail.search", "mail.reply"],
    "expect": {"kind": "chain", "calls": [
      {"name": "mail.search", "args": {"query": "budget"}, "arg_match": {"query": "present"}},
      {"name": "mail.reply", "args": {"message_id": "*", "body": "*"},
       "arg_match": {"message_id": "present", "body": "present"}}]}
  },
  {
    "id": "chain_free_then_book",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Am I free at 3 today? If so, book a 30-minute call with Alex."}],
    "catalog": ["calendar.find_free_slots", "calendar.create_event"],
    "expect": {"kind": "chain", "calls": [
      {"name": "calendar.find_free_slots", "args": {}, "arg_match": {}},
      {"name": "calendar.create_event", "args": {"title": "*", "start": "*"},
       "arg_match": {"title": "present", "start": "present"}}]}
  },
  {
    "id": "chain_find_text_daisy",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Find the Q3 budget spreadsheet and text its location to Daisy."}],
    "catalog": ["files.search", "messages.send"],
    "expect": {"kind": "chain", "calls": [
      {"name": "files.search", "args": {"query": "Q3 budget"}, "arg_match": {"query": "present"}},
      {"name": "messages.send", "args": {"recipient": "Daisy", "body": "*"},
       "arg_match": {"recipient": "normalized", "body": "present"}}]}
  },
  {
    "id": "chain_unread_reply_daisy",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Check my unread email and reply to Daisy's saying yes."}],
    "catalog": ["mail.list_unread", "mail.reply"],
    "expect": {"kind": "chain", "calls": [
      {"name": "mail.list_unread", "args": {}, "arg_match": {}},
      {"name": "mail.reply", "args": {"message_id": "*", "body": "*"},
       "arg_match": {"message_id": "present", "body": "present"}}]}
  },
  {
    "id": "chain_lookup_email",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Look up Daisy's email address and send her the meeting agenda."}],
    "catalog": ["contacts.find", "mail.send"],
    "expect": {"kind": "chain", "calls": [
      {"name": "contacts.find", "args": {"name": "Daisy"}, "arg_match": {"name": "normalized"}},
      {"name": "mail.send", "args": {"to": "*"}, "arg_match": {"to": "present"}}]}
  },
  {
    "id": "chain_move_standup",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Find my standup and move it to 11am."}],
    "catalog": ["calendar.list_events", "calendar.update_event"],
    "expect": {"kind": "chain", "calls": [
      {"name": "calendar.list_events", "args": {}, "arg_match": {}},
      {"name": "calendar.update_event", "args": {"event_id": "*", "new_start": "11:00"},
       "arg_match": {"event_id": "present", "new_start": "normalized"}}]}
  },
  {
    "id": "chain_find_delete_invoice",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Find the invoice PDF in my Downloads and move it to the trash."}],
    "catalog": ["files.search", "files.trash"],
    "expect": {"kind": "chain", "calls": [
      {"name": "files.search", "args": {"query": "invoice"}, "arg_match": {"query": "present"}},
      {"name": "files.trash", "args": {"path": "*"}, "arg_match": {"path": "present"}}]}
  },
  {
    "id": "chain_search_play",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Search for something chill and play it."}],
    "catalog": ["music.search", "music.play"],
    "expect": {"kind": "chain", "calls": [
      {"name": "music.search", "args": {"query": "*"}, "arg_match": {"query": "present"}},
      {"name": "music.play", "args": {}, "arg_match": {}}]}
  },
  {
    "id": "chain_forward_budget",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Find the budget review email and forward it to Daisy."}],
    "catalog": ["mail.search", "mail.forward"],
    "expect": {"kind": "chain", "calls": [
      {"name": "mail.search", "args": {"query": "budget review"}, "arg_match": {"query": "present"}},
      {"name": "mail.forward", "args": {"message_id": "*", "to": "*"},
       "arg_match": {"message_id": "present", "to": "present"}}]}
  },
  {
    "id": "chain_next_meeting_remind",
    "tier": "chain",
    "messages": [{"role": "user", "content": "What's my next meeting? Set a reminder to prep for it."}],
    "catalog": ["calendar.list_events", "reminders.create"],
    "expect": {"kind": "chain", "calls": [
      {"name": "calendar.list_events", "args": {}, "arg_match": {}},
      {"name": "reminders.create", "args": {"text": "*"}, "arg_match": {"text": "present"}}]}
  },
  {
    "id": "chain_sarahchen_text",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Find Sarah Chen's number and text her that I'm on my way."}],
    "catalog": ["contacts.find", "messages.send"],
    "expect": {"kind": "chain", "calls": [
      {"name": "contacts.find", "args": {"name": "Sarah Chen"}, "arg_match": {"name": "normalized"}},
      {"name": "messages.send", "args": {"recipient": "*", "body": "*"},
       "arg_match": {"recipient": "present", "body": "present"}}]},
    "notes": "Sarah Chen is a full name -> unambiguous, so this is a chain not a clarify"
  },
  {
    "id": "chain_free_deepwork",
    "tier": "chain",
    "messages": [{"role": "user", "content": "Find a free slot this afternoon and schedule 'Deep work' there."}],
    "catalog": ["calendar.find_free_slots", "calendar.create_event"],
    "expect": {"kind": "chain", "calls": [
      {"name": "calendar.find_free_slots", "args": {}, "arg_match": {}},
      {"name": "calendar.create_event", "args": {"title": "Deep work", "start": "*"},
       "arg_match": {"title": "normalized", "start": "present"}}]}
  }
]
