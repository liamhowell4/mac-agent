[
 {
  "id": "s2_volume_down",
  "tier": "single",
  "messages": [
   {
    "role": "user",
    "content": "Lower the volume to 15."
   }
  ],
  "catalog": [
   "system.set_volume"
  ],
  "expect": {
   "kind": "tool_call",
   "calls": [
    {
     "name": "system.set_volume",
     "args": {
      "level": 15
     },
     "arg_match": {
      "level": "normalized"
     }
    }
   ]
  }
 },
