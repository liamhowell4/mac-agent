 {
  "id": "c2_sarahkim_notes",
  "tier": "chain",
  "messages": [
   {
    "role": "user",
    "content": "Find Sarah Kim's email address and send her the standup notes file."
   }
  ],
  "catalog": [
   "contacts.find",
   "mail.send",
   "files.search"
  ],
  "expect": {
   "kind": "chain",
   "calls": [
    {
     "name": "contacts.find",
     "args": {
      "name": "Sarah Kim"
     },
