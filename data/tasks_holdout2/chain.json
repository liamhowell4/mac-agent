 {
  "id": "c2_gym_to_6",
  "tier": "chain",
  "messages": [
   {
    "role": "user",
    "content": "Move my gym session to 6pm."
   }
  ],
  "catalog": [
   "calendar.list_events",
   "calendar.update_event"
  ],
  "expect": {
   "kind": "chain",
   "calls": [
    {
     "name": "calendar.list_events",
     "args": {}
    },
    {
     "name": "calendar.update_event",
     "args": {
      "event_id": "*",
      "new_start": "18:00"
     },
     "arg_match": {
      "new_start": "normalized"
     }
    }
   ]
  }
