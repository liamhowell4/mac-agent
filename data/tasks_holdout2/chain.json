[
 {
  "id": "c2_delete_digest",
  "tier": "chain",
  "messages": [
   {
    "role": "user",
    "content": "Find the weekly digest newsletter in my inbox and delete it."
   }
  ],
  "catalog": [
   "mail.search",
   "mail.delete"
  ],
  "expect": {
   "kind": "chain",
   "calls": [
    {
     "name": "mail.search",
     "args": {
      "query": "*"
     }
    },
    {
     "name": "mail.delete",
     "args": {
      "message_id": "*"
     }
    }
   ]
  }
 },
 {
  "id": "c2_copy_invoice",
  "tier": "chain",
  "messages": [
   {
    "role": "user",
    "content": "Find the invoice PDF and copy it into Documents."
   }
  ],
  "catalog": [
   "files.search",
   "files.copy"
  ],
  "expect": {
   "kind": "chain",
   "calls": [
    {
     "name": "files.search",
     "args": {
      "query": "*"
     },
     "any_of": [
      "files.recent",
      "files.list_dir"
     ]
    },
    {
     "name": "files.copy",
     "args": {
      "src": "*",
      "dest": "*"
     }
    }
   ]
  }
 },
